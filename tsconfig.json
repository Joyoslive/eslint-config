{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"noEmitOnError": true,
		"rootDir": ".",
		"outDir": "./dist"
	},
	"include": ["index.ts", "types.ts", "src/**/*.ts", "vite.config.ts"]
}
