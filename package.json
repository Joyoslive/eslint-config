{
	"name": "@joyosdev/eslint",
	"version": "1.0.1",
	"description": "Just my personal eslint config, a constant work-in-progress",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist/index.js",
		"dist/index.d.ts",
		"dist/types.d.ts",
		"dist/src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Joyoslive/eslint-config.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "vite build && tsc",
		"typecheck": "tsc --noEmit",
		"prepack": "npm run build",
		"prepublishOnly": "npm test",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-plugin-solid": "^0.18.0",
		"typescript-eslint": "^8.64.0"
	},
	"peerDependencies": {
		"eslint": ">=9"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	}
}
